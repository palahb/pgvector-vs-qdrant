                  1,
                  8,
                  32,
                  48
                ],
                "pg_shared_buffers": "32GB",
                "pg_effective_cache": "64GB",
                "pg_maintenance_mem": "16GB",
                "pg_planner": "force-index",
                "pg_conn_modes": [
