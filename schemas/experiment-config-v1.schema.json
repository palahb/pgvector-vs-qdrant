{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/experiment-config-v1.schema.json",
  "title": "Immutable TRUBA experiment configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "experiment_id", "code_commit", "registry_root", "resources", "stages"],
  "properties": {
    "schema_version": {"const": 1},
    "experiment_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "code_commit": {"oneOf": [{"const": "AUTO"}, {"type": "string", "pattern": "^[0-9a-f]{40}$"}]},
    "registry_root": {"type": "string", "minLength": 1},
    "requires_smoke": {"type": "boolean"},
    "max_retries": {"type": "integer", "minimum": 0, "maximum": 5},
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["partition", "cpus", "memory", "time"],
      "properties": {
        "partition": {"type": "string", "minLength": 1},
        "cpus": {"type": "integer", "minimum": 1},
        "memory": {"type": "string", "pattern": "^[0-9]+[GM]$"},
        "time": {"type": "string", "pattern": "^[0-9]{2,3}:[0-9]{2}:[0-9]{2}$"},
        "array_concurrency": {"type": "integer", "minimum": 1},
        "exclude": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min_free_gb": {"type": "number", "minimum": 0},
        "min_inode_free_percent": {"type": "number", "minimum": 0, "maximum": 100}
      }
    },
    "base_args": {"type": "object"},
    "engine_args": {"type": "object"},
    "stages": {
      "type": "object",
      "required": ["pilot", "full"],
      "properties": {
        "pilot": {"$ref": "#/$defs/stage"},
        "full": {"$ref": "#/$defs/stage"}
      },
      "additionalProperties": {"$ref": "#/$defs/stage"}
    }
  },
  "$defs": {
    "stage": {
      "type": "object",
      "required": ["matrix"],
      "properties": {
        "matrix": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "array", "minItems": 1}},
        "engines": {"type": "array", "items": {"enum": ["pg", "qdrant"]}, "minItems": 1, "uniqueItems": true},
        "base_args": {"type": "object"},
        "engine_args": {"type": "object"}
      },
      "additionalProperties": false
    }
  }
}
